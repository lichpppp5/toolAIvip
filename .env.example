# LiveGuard — environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Vault & identity
# ---------------------------------------------------------------------------

# Path to the age-encrypted secrets vault
LIVEGUARD_VAULT_PATH=./secrets/vault.age

# Path to the age identity file (private key) — keep chmod 600
LIVEGUARD_IDENTITY_PATH=~/.config/liveguard/identity.age

# ---------------------------------------------------------------------------
# OBS WebSocket (stored in vault after Phase 5; bootstrap only here)
# ---------------------------------------------------------------------------

# OBS WebSocket server host
LIVEGUARD_OBS_HOST=localhost

# OBS WebSocket server port
LIVEGUARD_OBS_PORT=4455

# ---------------------------------------------------------------------------
# Stream key (NEVER store long-term — enter at runtime only)
# ---------------------------------------------------------------------------

# TikTok RTMP stream key — entered at CLI prompt; never stored
# LIVEGUARD_STREAM_KEY=<runtime only, do not set here>

# ---------------------------------------------------------------------------
# Audit log
# ---------------------------------------------------------------------------

# Directory for the append-only HMAC audit log
LIVEGUARD_AUDIT_DIR=./audit

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# Bind address for Streamlit dashboard
LIVEGUARD_DASHBOARD_HOST=127.0.0.1

# Port for Streamlit dashboard
LIVEGUARD_DASHBOARD_PORT=8501
